{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Config dédiée aux TESTS (vitest-pool-workers). Les « secrets » y sont
  // des CONSTANTES DE TEST non secrètes, sans valeur réelle. Ce fichier ne
  // sert JAMAIS au déploiement (voir wrangler.jsonc).
  "name": "vitrine-video-lite-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vitrine-video-lite-test-db",
      "database_id": "local-test"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "PAYMENT_MODE": "simulation",
    "CINETPAY_ENABLED": "false",
    "CINETPAY_ENV": "test",
    "API_VERSION": "1.0.0-test",
    "DEVICE_ID_HMAC_SECRET": "test-hmac-secret-0123456789abcdef0123456789abcdef",
    "ADMIN_METRICS_TOKEN": "test-admin-token-0123456789abcdef",
    "SIMULATION_SECRET": "test-simulation-secret-0123456789abcdef"
  }
}
