{
  "name": "vitrine-video-server",
  "version": "1.0.0",
  "description": "Backend Vitrine Video Lite — Cloudflare Workers + D1 + CinetPay (serveur uniquement)",
  "private": false,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "dev": "wrangler d1 migrations apply vitrine-video-lite-staging-db --local && wrangler dev --port 8787",
    "e2e:local": "bash scripts/e2e-runner.sh local",
    "e2e:staging": "bash scripts/e2e-runner.sh staging"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
